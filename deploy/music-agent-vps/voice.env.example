# Arquivo /etc/music-agent/voice.env; chmod 600, dono root.
MUSIC_AGENT_BOT_TOKEN=PREENCHA_TOKEN_DO_BOT
MUSIC_AGENT_TOKEN=PREENCHA_TOKEN_PRIVADO_DA_API
MUSIC_AGENT_ENV=/etc/music-agent/voice.env
PHONE_WORKER_ENV=/etc/music-agent/no-phone-worker.env
MUSIC_AGENT_EXECUTOR_MODE=voice
MUSIC_AGENT_HOST=127.0.0.1
MUSIC_AGENT_PORT=8767
MUSIC_AGENT_YTDLP_JS_RUNTIMES=node
MUSIC_AGENT_DIRECT_AUDIO_ENABLED=true
MUSIC_AGENT_PCM_BUFFER_ENABLED=true
MUSIC_AGENT_PCM_BUFFER_MAX_FRAMES=75
MUSIC_AGENT_INITIAL_AUDIO_PREPARE_ENABLED=true
MUSIC_AGENT_NEXT_AUDIO_PREPARE_ENABLED=true
MUSIC_AGENT_NEXT_AUDIO_PREPARE_MAX_SOURCES=1
MUSIC_AGENT_FAST_IDLE_RETENTION_SECONDS=600
MUSIC_AGENT_VOICE_EMPTY_DISCONNECT_SECONDS=2
MUSIC_AGENT_AUDIO_TELEMETRY_ENABLED=true
# Opcional: cookies de YouTube somente se necessários; chmod 640 root:music-agent.
# MUSIC_AGENT_YTDLP_COOKIES_FILE=/etc/music-agent/youtube-cookies.txt
