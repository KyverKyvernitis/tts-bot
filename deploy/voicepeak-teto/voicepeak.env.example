# Copie para voicepeak.env no host com VOICEPEAK instalado e licenciado.
# Use o IP privado do host para permitir acesso pelo phone worker.
VOICEPEAK_HOST=127.0.0.1
VOICEPEAK_PORT=8087
VOICEPEAK_TOKEN=SUBSTITUA_POR_UM_TOKEN_ALEATORIO
PHONE_WORKER_TETO_ENABLED=true
# Caminho real do executável; um único caminho, sem argumentos.
PHONE_WORKER_VOICEPEAK_COMMAND=/caminho/real/para/voicepeak
PHONE_WORKER_VOICEPEAK_NARRATOR=重音テト
PHONE_WORKER_VOICEPEAK_TEXT_MODE=ptbr-kana
PHONE_WORKER_VOICEPEAK_SPEED=100
PHONE_WORKER_VOICEPEAK_PITCH=0
# Consulte --list-emotion antes de preencher; nomes precisam existir na instalação.
PHONE_WORKER_VOICEPEAK_EMOTION=
PHONE_WORKER_TETO_MAX_CHARACTERS=180
PHONE_WORKER_TETO_MAX_AUDIO_SECONDS=20
