# Managed by Osaka Edge secondary IP installer v1.
[Unit]
Description=Preserve the Osaka Edge secondary IPv4 address
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/osaka-edge-secondary-ip.py ensure --config /etc/osaka-edge-secondary-ip.json
TimeoutStartSec=45
RemainAfterExit=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
