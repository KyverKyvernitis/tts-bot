# Permite que o bot dispare o updater imediatamente após o push do ZIP.
# Escopo mínimo: iniciar apenas a unit bot-updater.service.
ubuntu ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block bot-updater.service
ubuntu ALL=(root) NOPASSWD: /bin/systemctl start --no-block bot-updater.service
ubuntu ALL=(root) NOPASSWD: /usr/bin/systemctl start bot-updater.service
ubuntu ALL=(root) NOPASSWD: /bin/systemctl start bot-updater.service
