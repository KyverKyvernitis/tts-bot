class ReplayMemoryBudget:
    def __init__(self, limit: int) -> None: ...
    @property
    def limit(self) -> int: ...
    @property
    def used(self) -> int: ...
    def reserve(self, size: int) -> bool: ...
    def release(self, size: int) -> None: ...

class NativeReplayBuffer:
    def __init__(self, directory: str, budget: ReplayMemoryBudget, memory_limit: int, max_bytes: int) -> None: ...
    def append(self, data: bytes) -> None: ...
    def try_append_in_memory(self, data: bytes) -> bool: ...
    def read_at(self, offset: int, length: int) -> bytes: ...
    def try_read_in_memory(self, offset: int, length: int) -> bytes | None: ...
    def finish(self, error: str | None = None) -> None: ...
    def copy_to(self, path: str) -> None: ...
    def close(self) -> None: ...
    def snapshot(self) -> dict[str, Any]: ...

class NativeSourceHandle:
